# Postgres-Datenbank (z.B. Neon, Supabase, Render Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# "true" wenn die DB-Verbindung TLS erfordert (Neon/Supabase/Vercel Postgres: true)
DATABASE_SSL=true

# SMTP für E-Mail-Versand
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=ops@deine-firma.de
SMTP_PASS=geheim
SMTP_FROM="Operations-Team" <ops@deine-firma.de>
